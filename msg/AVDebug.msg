# Typed ROS representation of DFMM CAN frame 0x11A (AV Debug).
# The header timestamp is the VAM receive time.

# Vehicle state.
uint8 VEHICLE_STATE_IDLE=0
uint8 VEHICLE_STATE_REQUESTING_HV=1
uint8 VEHICLE_STATE_PRECHARGING=2
uint8 VEHICLE_STATE_HV_ACTIVATED=3
uint8 VEHICLE_STATE_ARMED_MAINTAIN=4
uint8 VEHICLE_STATE_FILLING=5
uint8 VEHICLE_STATE_DRIVING=6
uint8 VEHICLE_STATE_FINISHED=7
uint8 VEHICLE_STATE_HV_LOCKOUT=8
uint8 VEHICLE_STATE_LATCHING_FAULT=9
uint8 VEHICLE_STATE_EMERGENCY=10
uint8 VEHICLE_STATE_ARMING=11

# Legacy drive-state constants: NOT verified wire codes for the current M150.
# Use drive_state raw value; drive_state_name is Unverified until enumerated on hardware.
uint8 DRIVE_STATE_EMERGENCY=0
uint8 DRIVE_STATE_LATCHING_FAULT=1
uint8 DRIVE_STATE_HV_LOCKOUT=2
uint8 DRIVE_STATE_IDLE=3
uint8 DRIVE_STATE_REQUESTING_HV=4
uint8 DRIVE_STATE_PRECHARGING=5
uint8 DRIVE_STATE_HV_ACTIVATED=6
uint8 DRIVE_STATE_READY_TO_DRIVE=7

# Heartbeat timeout source.
uint8 HEARTBEAT_FAILURE_NONE=0
uint8 HEARTBEAT_FAILURE_RES=1
uint8 HEARTBEAT_FAILURE_PC=2
uint8 HEARTBEAT_FAILURE_PC_WATCHDOG=3
uint8 HEARTBEAT_FAILURE_STEERING=4
uint8 HEARTBEAT_FAILURE_PDM=5
uint8 HEARTBEAT_FAILURE_PC_DATALOGGER=6

# DFMM failure mode.
uint8 DFMM_FAILURE_NONE=0
uint8 DFMM_FAILURE_EBS=1
uint8 DFMM_FAILURE_WATCHDOG=2
uint8 DFMM_FAILURE_SDC=3
uint8 DFMM_FAILURE_R2D=4
uint8 DFMM_FAILURE_STEERING=5
uint8 DFMM_FAILURE_DRIVE_STATE=6
uint8 DFMM_FAILURE_DRIVING=7
uint8 DFMM_FAILURE_LEFT_INVERTER=8
uint8 DFMM_FAILURE_RIGHT_INVERTER=9
uint8 DFMM_FAILURE_BMS=10
uint8 DFMM_FAILURE_EBS_FILL_TIMEOUT=11
uint8 DFMM_FAILURE_FINISHED_EMERGENCY=12
uint8 DFMM_FAILURE_HV_ACTIVE_IN_BYPASS=13

# Drive-state failure detail.
uint8 DRIVE_STATE_FAILURE_NONE=0
uint8 DRIVE_STATE_FAILURE_LEFT_INVERTER_NOT_READY=1
uint8 DRIVE_STATE_FAILURE_RIGHT_INVERTER_NOT_READY=2
uint8 DRIVE_STATE_FAILURE_PRECHARGE_ERROR=3
uint8 DRIVE_STATE_FAILURE_LEFT_INVERTER_HV_LOSS=4
uint8 DRIVE_STATE_FAILURE_RIGHT_INVERTER_HV_LOSS=5
uint8 DRIVE_STATE_FAILURE_ACCUMULATOR_PRECHARGE_LOSS=6
uint8 DRIVE_STATE_FAILURE_ACCUMULATOR_OVERTEMP=7
uint8 DRIVE_STATE_FAILURE_EBS_UNAVAILABLE=8
uint8 DRIVE_STATE_FAILURE_EBS_FILL_TIMEOUT=9
uint8 DRIVE_STATE_FAILURE_R2D_ASMS_OFF=10
# Deprecated alias; current condition is TS Activation, not the RES switch.
uint8 DRIVE_STATE_FAILURE_R2D_RES_HV_OFF=11
uint8 DRIVE_STATE_FAILURE_R2D_TS_ACTIVATION_OFF=11
uint8 DRIVE_STATE_FAILURE_R2D_EBS_NOT_ACTIVATED=12
# Deprecated alias.
uint8 DRIVE_STATE_FAILURE_DRIVING_RES_HV_OFF=13
uint8 DRIVE_STATE_FAILURE_DRIVING_TS_ACTIVATION_OFF=13
uint8 DRIVE_STATE_FAILURE_AV_EMERGENCY=14
uint8 DRIVE_STATE_FAILURE_HV_ACTIVE_IN_BYPASS=15

# EBS control command.
uint8 EBS_CONTROL_RELEASE_BOTH=0
uint8 EBS_CONTROL_UNUSED_1=1
uint8 EBS_CONTROL_RELEASE_VALVE_1=2
uint8 EBS_CONTROL_UNUSED_3=3
uint8 EBS_CONTROL_RELEASE_VALVE_2=4
uint8 EBS_CONTROL_UNUSED_5=5
uint8 EBS_CONTROL_MAINTAIN=6
uint8 EBS_CONTROL_FILL=7

# Inverter boot state.
uint8 INVERTER_BOOT_STATE_FAULT=0
uint8 INVERTER_BOOT_STATE_SYSTEM_READY=1
uint8 INVERTER_BOOT_STATE_HV_ACTIVATION_REQUESTED=2
uint8 INVERTER_BOOT_STATE_HV_ACTIVATED=3
uint8 INVERTER_BOOT_STATE_CONTROLLER_ENABLE_REQUESTED=4
uint8 INVERTER_BOOT_STATE_CONTROLLER_ENABLED=5

# Legacy watchdog constants: NOT verified wire codes for the current M150.
uint8 PC_WATCHDOG_EMERGENCY=0
uint8 PC_WATCHDOG_INITIALISATION=1
uint8 PC_WATCHDOG_OK=2

# Precharge state.
uint8 PRECHARGE_ERROR=0
uint8 PRECHARGE_IDLE=1
uint8 PRECHARGE_MEASURE=2
uint8 PRECHARGE_PRECHARGE=3
uint8 PRECHARGE_RUN=4
uint8 PRECHARGE_ENABLE_PACK=5

# Initial check state.
uint8 CHECKUP_STOP_ECHOING_HEARTBEAT=0
uint8 CHECKUP_CHECK_HEARTBEATS_LOW=1
uint8 CHECKUP_RESTART_M150_HEARTBEAT=2
uint8 CHECKUP_CHECK_HEARTBEATS_HIGH=3
uint8 CHECKUP_CHECK_EBS_CANISTER=4
uint8 CHECKUP_CHECK_BRAKES_ON_1=5
uint8 CHECKUP_ENABLE_TS=6
uint8 CHECKUP_CHECK_TS_ENABLED=7
uint8 CHECKUP_FILL_EBS_LINE_1=8
uint8 CHECKUP_CHECK_BRAKES_OFF_1=9
uint8 CHECKUP_VENT_VALVE_1=10
uint8 CHECKUP_CHECK_BRAKES_ON_2=11
uint8 CHECKUP_FILL_EBS_LINE_2=12
uint8 CHECKUP_CHECK_BRAKES_OFF_2=13
uint8 CHECKUP_VENT_VALVE_2=14
uint8 CHECKUP_CHECK_BRAKES_ON_3=15
uint8 CHECKUP_COMPLETE=16

std_msgs/Header header

uint8 vehicle_state
string vehicle_state_name
uint8 drive_state
string drive_state_name
bool vam_timeout
uint8 heartbeat_failure
string heartbeat_failure_name
uint8 dfmm_failure_mode
string dfmm_failure_mode_name
uint8 drive_state_failure
string drive_state_failure_name
uint8 ebs_control
string ebs_control_name
uint8 inverter_left_boot_state
string inverter_left_boot_state_name
uint8 inverter_right_boot_state
string inverter_right_boot_state_name
uint8 pc_watchdog_status
string pc_watchdog_status_name
uint8 precharge_state
string precharge_state_name
bool av_emergency
uint8 checkup_status
string checkup_status_name
bool sdc_sense
